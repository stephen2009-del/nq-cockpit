datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Rule {
  id        Int      @id @default(autoincrement())
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Trade {
  id                Int      @id @default(autoincrement())
  date              DateTime @default(now())
  symbol            String
  dir               String
  session           String
  entry             Float?
  exit              Float?
  size              Float?
  pnl               Float
  setup             String?
  emotion           String?
  notes             String?
  disciplined       Boolean
  checklistSnapshot Json
}

model Settings {
  id                   Int    @id @default(1)
  dailyLossLimit       Float  @default(500)
  contract             String @default("NQ")
  multiplier           Float  @default(20)
  tradingWindowStart   String @default("09:30")
  tradingWindowEnd     String @default("16:00")
  cutoffMinutesBeforeClose Int @default(65)
  openingBufferMinutes Int    @default(10)
  tradovateEnv         String @default("demo")
}

model TradovateOrderLog {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  env            String
  symbol         String
  side           String
  qty            Int
  orderType      String
  limitPrice     Float?
  status         String
  blockedReason  String?
  tradovateOrderId String?
  rawResponse    Json?
}

model PreMarketPrep {
  id                Int      @id @default(autoincrement())
  date              DateTime @default(now())
  qqqPrice          Float
  multiplier        Float
  estimatedMove     Float
  nqPrice           Float
  openInterestNotes String?
}

model OpenInterestLevel {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  strike Float
  oi     Float
  note   String?
}

model IntradayCheck {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  qqqPrice Float
  nqPrice  Float
}
