datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Rule {
  id        Int      @id @default(autoincrement())
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Trade {
  id                Int      @id @default(autoincrement())
  date              DateTime @default(now())
  symbol            String
  dir               String
  session           String
  entry             Float?
  exit              Float?
  // Separate from `date` (which is exit time for synced trades) — lets
  // hold time actually be computed. Null for manual entries and anything
  // synced before this field existed.
  entryDate         DateTime?
  size              Float?
  pnl               Float
  setup             String?
  emotion           String?
  notes             String?
  disciplined       Boolean?
  checklistSnapshot Json
  plannedStop       Float?
  plannedTarget     Float?
  // "manual" (typed in via Pre-Trade/Journal), "demo", or "live" — which
  // Tradovate environment (if any) a synced trade came from. Column already
  // existed in the DB from an earlier migration; this just declares it in
  // the schema so Prisma actually reads/writes it.
  source            String   @default("manual")
}

model Settings {
  id                   Int    @id @default(1)
  dailyLossLimit       Float  @default(500)
  contract             String @default("NQ")
  multiplier           Float  @default(20)
  tradingWindowStart   String @default("09:30")
  tradingWindowEnd     String @default("16:00")
  cutoffMinutesBeforeClose Int @default(65)
  openingBufferMinutes Int    @default(10)
  tradovateEnv         String @default("demo")
  tradingWindowLocked  Boolean @default(false)
  // Pins a specific account per environment, for when more than one exists
  // (e.g. Live has two accounts but only one is actually active). Null
  // means "auto-select if there's only one account, otherwise ask."
  liveAccountId        String?
  demoAccountId        String?
  // Hard caps on adding to an already-open same-direction position, built
  // after a week's report showed up to 11 concurrent longs stacked with a
  // ~1-minute median gap between adds. Unlike the P&L-based losing-position
  // guard, these are deterministic counts/timers enforced identically on
  // demo and live — there's no "can't verify" case to fail open on.
  maxConcurrentAdds    Int    @default(2) // max net contracts allowed in one direction, per symbol
  addOnCooldownMinutes Int    @default(3) // minimum minutes between same-direction entries in a symbol
  // Real-time unrealized-loss alert threshold (dollars, positive number) —
  // built after a specific admitted pattern: trade goes against the
  // trader, they go disable Tradovate's own daily loss limit directly (a
  // path this app can't see or block), then add to the loser. This can't
  // stop that sequence, but it can shrink the gap between "this trade
  // just went underwater" and "I know that" from a full day down to
  // about a minute, aimed at catching the trigger before the rest of the
  // sequence starts. 0 or null disables the check entirely.
  unrealizedLossAlertThreshold Float @default(500)
  // Blocks ANY new order (any symbol, any direction) for N minutes after a
  // realized loss of this size or worse — built specifically because
  // journal entries described "Tilted / Revenge" behavior that isn't
  // limited to averaging into the same losing position. 0 disables it.
  postLossCooldownMinutes  Int   @default(5)
  postLossCooldownThreshold Float @default(300)
}

model TradovateOrderLog {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  env            String
  symbol         String
  side           String
  qty            Int
  orderType      String
  limitPrice     Float?
  stopLossPrice  Float?
  targetPrice    Float?
  status         String
  blockedReason  String?
  addReason      String?  // why you added to an already-open same-direction position — captured
                          // at order time via a required prompt in the Trade Ticket, specifically
                          // to fill the gap where synced Tradovate fills otherwise carry zero
                          // self-reported context (unlike manually-logged Journal entries).
  tradovateOrderId String?
  rawResponse    Json?
}

model PreMarketPrep {
  id                Int      @id @default(autoincrement())
  date              DateTime @default(now())
  qqqPrice          Float
  multiplier        Float
  estimatedMove     Float
  nqPrice           Float
  openInterestNotes String?
}

model OpenInterestLevel {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  strike Float
  oi     Float
  note   String?
}

model IntradayCheck {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  qqqPrice Float
  nqPrice  Float
}

model TradeLockout {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  until     DateTime
  reason    String
}

model EmotionalLogEntry {
  id   Int      @id @default(autoincrement())
  date DateTime @default(now())
  tag  String?
  note String
}

model StopManagementRule {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now())
  env            String
  accountId      Int
  symbol         String
  direction      String    // "long" or "short"
  entryPrice     Float
  qty            Int
  triggerOffset  Float     // points from entry that trigger the move
  newStopOffset  Float     // points from entry for the new stop price
  status         String    @default("active") // active | triggered | failed | cancelled
  triggeredAt    DateTime?
  newStopPrice   Float?
  verified       Boolean?
  detail         String?
}

model SchwabToken {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  updatedAt    DateTime @updatedAt
}

// Chart screenshots (e.g. from Thinkorswim) uploaded during the day as a
// reminder of good/bad trades. Grouped into reports by date.
model ChartSnapshot {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  note      String?
  imageData String   // base64 data URI, resized/compressed client-side before upload
}
